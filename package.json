{
  "name": "i-hate-pdf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "python3 -m http.server 4173 --directory dist",
    "test": "node tests/engine-regressions.mjs && node tests/new-tools-check.mjs && node tests/editor-export-check.mjs && node tests/review-check.mjs",
    "setup:translation": "node scripts/download-models.mjs",
    "test:archive": "node tests/archive-check.mjs",
    "setup:writing": "node scripts/download-writer.mjs",
    "package": "node scripts/package-website.mjs",
    "setup:detector": "node scripts/download-detector.mjs",
    "build:production": "npm run setup:translation && npm run setup:writing && npm run setup:detector && npm run build && node scripts/production.mjs",
    "test:production": "node tests/production-check.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "blob-stream": "^0.1.3",
    "dictionary-en": "^4.0.0",
    "docx": "^9.5.1",
    "esbuild": "^0.25.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide": "^0.468.0",
    "mammoth": "^1.10.0",
    "nspell": "^2.1.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "tesseract.js": "^7.0.0"
  },
  "overrides": {
    "image-size": "^2.0.3",
    "uuid": "^11.1.1",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
